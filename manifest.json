{
    "manifest_version": 3,
    "name": "__MSG_appName__",
    "description": "__MSG_appDesc__",
    "default_locale": "en",
    "version": "0.0.0.1",
    "background": {
        "service_worker": "scripts/background.js"
    },
    "action": {
        "default_icon": {
            "16": "images/duptab.png",
            "32": "images/duptab.png"
        },
        "theme_icons": [
            {
                "light": "images/duptab.png",
                "dark": "images/duptab.png",
                "size": 16
            },
            {
                "light": "images/duptab.png",
                "dark": "images/duptab.png",
                "size": 32
            }
        ]
    },
    "permissions": ["activeTab"],
    "commands": {
        "_execute_action": {
            "suggested_key": "Ctrl+Shift+D"
        }
    }
}
